# ============================================
# AGAI - Configuration Environnement
# stocker les informations sensibles de l'application
# ============================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME="AGAI - Système de Suivi de l'Exécution du Programme de Surveillance Continue de la Sécurité Aérienne"
APP_SHORT_NAME="AGAI"
APP_VERSION="1.0.0"
APP_ENV=development
APP_DEBUG=true
APP_MAINTENANCE=false

# ------------------------------------------------------------
# URL - Automatique en local
# ------------------------------------------------------------
#APP_URL=http://localhost/AGAI
APP_URL=http://192.168.5.3:7700/AGAI
APP_URL_AUTO=true

# ------------------------------------------------------------
# BASE DE DONNÉES
# ------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=siganac
DB_USER=user_siganac
DB_PASSWORD=Eth@n@2018
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ------------------------------------------------------------
# SÉCURITÉ
# ------------------------------------------------------------
SECURITY_SALT="AGAI_SECURE_SALT_2026_ANAC_GABON"
SESSION_TIMEOUT=3600
#nbre de tentative de connexion Par utilisateur
MAX_LOGIN_ATTEMPTS=5 
#nbre de tentative de connexion Par IP
MAX_LOGIN_ATTEMPTS_IP=20 
# 15 minutes
LOCKOUT_TIME=900 
# activer l'authentification à deux facteurs
TWO_FA_ENABLED=true 
# longueur du code
TWO_FA_CODE_LENGTH=6 
TWO_FA_EXPIRY=600 
# durée de validité du code OTP, en secondes (10 min)
MAX_OTP_ATTEMPTS=5      
# essais avant d'exiger un nouveau code,après 5 mauvais codes, le code est invalidé et,il faut en demander un nouveau: impossible de deviner les 6 chiffres par force brute.
CSRF_TOKEN_NAME=csrf_token 
# nom du token CSRF
CSRF_TOKEN_LIFETIME=3600 
# durée de validité du token CSRF, en secondes (1 heure)

# ------------------------------------------------------------
# HEADERS DE SÉCURITÉ (Désactivés en local)
# ------------------------------------------------------------
SECURE_HEADERS_ENABLED=false # activer les headers de sécurité
FORCE_HTTPS=false # forcer l'utilisation de HTTPS

# ------------------------------------------------------------
# EMAIL (PHPMailer)
# ------------------------------------------------------------
# serveur SMTP
MAIL_HOST=smtp.gmail.com 
# port SMTP
MAIL_PORT=465 
# adresse email
MAIL_USERNAME=siganac.anacgabon@gmail.com 
# mot de passe
MAIL_PASSWORD=phffcbxvhxasnxkz 
# encryption
MAIL_ENCRYPTION=ssl 
# adresse email de l'expéditeur
MAIL_FROM=siganac.anacgabon@gmail.com 
# nom de l'expéditeur
MAIL_FROM_NAME="AGAI - ANAC Gabon" 
# charset
MAIL_CHARSET=UTF-8 
# debug
MAIL_DEBUG=false 
# activer l'envoi d'emails
MAIL_ENABLED=true 



# ------------------------------------------------------------
# UPLOAD
# ------------------------------------------------------------
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,gif
ALLOWED_MIME_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/jpeg,image/png,image/gif

# ------------------------------------------------------------
# PAGINATION
# ------------------------------------------------------------
ITEMS_PER_PAGE=25
DEFAULT_SORT=created_at DESC

# ------------------------------------------------------------
# LOGS
# ------------------------------------------------------------
LOG_RETENTION_DAYS=30
LOG_LEVEL=debug

# ------------------------------------------------------------
# LOCALISATION
# ------------------------------------------------------------
TIMEZONE=Africa/Libreville
LOCALE=fr_FR.UTF-8
DEFAULT_LANG=fr
AVAILABLE_LANGS=fr,en

# ------------------------------------------------------------
# DATES
# ------------------------------------------------------------
DATE_FORMAT=d/m/Y
DATETIME_FORMAT=d/m/Y H:i:s
DATE_DB_FORMAT=Y-m-d
DATETIME_DB_FORMAT=Y-m-d H:i:s

# ------------------------------------------------------------
# INTÉGRATIONS
# ------------------------------------------------------------
POWER_BI_ENABLED=false
POWER_BI_EMB